; DEMO (2026-10-23): the AmiFFE release unpacked on Work:, normal Workbench boot, sound on. JIT OFF (cachesize=0): JIT is for development only, never for testing
config_description=AmiFFE demo: Workbench 3.1, 68020 no FPU, JIT OFF, AGA + RTG
cpu_type=68020
cpu_model=68020
fpu_model=0
cpu_compatible=true
cpu_24bit_addressing=false
cpu_speed=max
cpu_throttle=-800.0
cachesize=0
chipset=aga
chipset_compatible=A1200
chipmem_size=4
fastmem_size=0
z3mem_size=32
gfx_api=0
gfx_width_windowed=800
gfx_height_windowed=600
gfx_fullscreen_amiga=false
magic_mouse=true
magic_mousecursor=1
input.mouse_speed=100
win32.start_not_captured=true
win32.active_not_captured_pause=false
win32.active_not_captured_nosound=false
win32.inactive_pause=false
win32.inactive_nosound=true
win32.inactive_iconify=false
win32.iconified_pause=false
win32.iconified_nosound=true
win32.posx=-1860
win32.posy=60
use_gui=no
show_leds=true
sound_output=exact
sound_channels=stereo
sound_bits=16
sound_frequency=44100
sound_interpol=none
sound_filter=emulated
sound_stereo_separation=10
sound_latency=100
bsdsocket_emu=true
cpu_cycle_exact=false
cpu_memory_cycle_exact=false
blitter_cycle_exact=false
fpu_strict=false
kickstart_rom_file=E:\ffe\ROM3.1_A4000.40.70.ROM
hardfile2=ro,DH0:C:\Users\Admin\AppData\Local\ffe-amiga\boot.hdf,32,1,2,512,0,,uae
filesystem2=rw,WORK:Work:E:\ffe\demo,-128
gfxcard_size=16
gfxcard_type=uaegfx
gfxcard_hardware_sprite=false
